{
  "expo": {
    "name": "Bickers",
    "slug": "bickers-app",
    "version": "5.0.13",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bickersapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "88",
      "bundleIdentifier": "com.bickers.booking",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Bickers to photograph receipts, maintenance issues and job records.",
        "NSPhotoLibraryUsageDescription": "Bickers uses photos you select from your library to attach receipts to expenses, profile photos to your account, and vehicle or job photos to work records."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bickers.bickersapp",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Bickers App",
      "shortName": "Bickers",
      "display": "standalone",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff",
      "lang": "en-GB",
      "meta": {
        "description": "Bickers Action bookings & operations."
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bickers uses photos you select from your library to attach receipts to expenses, profile photos to your account, and vehicle or job photos to work records.",
          "cameraPermission": "Allow Bickers to photograph receipts, maintenance issues and job records.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "@react-native-firebase/app",
      "./plugins/withFirebaseModularHeaders",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "aurex-design",
          "project": "react-native"
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "appEnv": "development",
      "syncEnabled": true,
      "syncIntervalMs": 120000,
      "syncTimeoutMs": 10000,
      "syncApiBaseUrl": "",
      "minSupportedAppVersion": "5.0.4",
      "minAndroidSdk": 24,
      "eas": {
        "projectId": "10adb241-72a5-4439-aa1a-e889302c92b3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/10adb241-72a5-4439-aa1a-e889302c92b3"
    }
  }
}
