{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "clerk-pilot": {
      "extends": "internal",
      "channel": "clerk-pilot",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_CLERK_SHARED_AUTH_ENABLED": "1",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYmlja2Vycy5jby51ayQ",
        "EXPO_PUBLIC_CLERK_BRIDGE_ORIGIN": "https://pilot.bickers.co.uk",
        "EXPO_PUBLIC_CLERK_DEPLOYMENT_ROLE": "pilot"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "internal": {
      "distribution": "internal",
      "channel": "candidate",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://bickers-mobile-api.onrender.com"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://bickers-mobile-api.onrender.com"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6754837128"
      },
      "android": {}
    }
  }
}
