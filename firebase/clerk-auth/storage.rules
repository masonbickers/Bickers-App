rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return userDocExists() ? userDoc().data : null;
    }

    function trustedClerkSession(data, legacyEmptyEmployee) {
      let token = request.auth.token;
      let firebaseClaims = token.get("firebase", {});
      let authData = data.get("auth", {});
      let storedClerkId = data.get("clerkUserId", "");
      let nestedClerkId = authData is map ? authData.get("clerkUserId", "") : "";
      return firebaseClaims is map
        && firebaseClaims.get("sign_in_provider", "") == "custom"
        && token.get("authMethod", "") == "clerk"
        && token.get("verifiedClerkEmail", false) == true
        && token.get("identityLinkVersion", 0) == 2
        && token.get("clerkSessionId", "") is string
        && token.get("clerkSessionId", "").size() > 0
        && token.get("clerkUserId", "") is string
        && token.get("clerkUserId", "").size() > 0
        && data.get("uid", "") == request.auth.uid
        && (storedClerkId in ["", null] || storedClerkId == token.get("clerkUserId", ""))
        && (nestedClerkId in ["", null] || nestedClerkId == token.get("clerkUserId", ""))
        && token.get("identityCompanyId", "") == data.get("companyId", "")
        && token.get("identityEmployeeId", null) is string
        && (token.get("identityEmployeeId", "") == data.get("employeeId", "")
          || legacyEmptyEmployee && token.get("identityEmployeeId", "") == "");
    }

    // Explicit, server-owned compatibility for the reconciled development cohort.
    // New tokens and a profile that has ever activated shared auth cannot use it.
    function legacyClerkWebAllowed(data, grant) {
      let token = request.auth.token;
      let role = data.get("role", "");
      let normalizedRole = role is string ? role.lower() : "";
      let issued = grant is map ? grant.get("issuedAtMs", 0) : 0;
      let expires = grant is map ? grant.get("validUntilMs", 0) : 0;
      return !token.keys().hasAny(["clerkLeaseVersion"])
        && !data.keys().hasAny(["clerkLeaseRequired"])
        && !data.keys().hasAny(["clerkSessionLeases"])
        && data.get("authMigrationState", "") != "clerk-only"
        && grant is map && grant.get("version", 0) == 1
        && grant.get("instanceId", "") == "ins_3GUkXKRF1LLr0E5Z5OS7LeHJO34"
        && grant.get("uid", "") == request.auth.uid
        && grant.get("clerkUserId", "") == token.get("clerkUserId", "")
        && grant.get("companyId", "") == data.get("companyId", "")
        && grant.get("employeeId", null) == data.get("employeeId", "")
        && role is string && grant.get("role", "") == normalizedRole
        && grant.get("allowEmptyEmployeeClaim", null) is bool
        && grant.get("allowEmptyEmployeeClaim", false) == (normalizedRole in ["admin", "platformadmin"])
        && issued is int && issued > 0 && expires is int && expires > issued
        && expires - issued <= 1209600000
        && issued <= request.time.toMillis() && request.time.toMillis() < expires;
    }

    function directSessionAllowed(data) {
      let token = request.auth.token;
      let authTime = token.get("auth_time", 0);
      let cutoff = data.get("sessionValidAfter", 0);
      return data.get("uid", "") == request.auth.uid
        && authTime is number && authTime > 0
        && cutoff is number && cutoff >= 0 && cutoff < 10000000000
        && authTime > cutoff
        && (data.get("sessionsRevokedAt", null) == null
          || data.keys().hasAny(["sessionValidAfter"]))
        && data.get("passwordResetRequired", false) == false;
    }

    // The server updates this mirror and its lifecycle index atomically.
    // Reuse the user read so Storage can still check its owning parent document.
    function clerkLeaseAllowed(data) {
      let token = request.auth.token;
      let leases = data.get("clerkSessionLeases", {});
      let sessionId = token.get("clerkSessionId", "");
      let lease = leases is map ? leases.get(sessionId, {}) : {};
      return lease is map && lease.get("status", "") == "active"
        && lease.get("uid", "") == request.auth.uid
        && lease.get("companyId", "") == data.get("companyId", "")
        && lease.get("clerkUserId", "") == token.get("clerkUserId", "")
        && lease.get("clerkSessionId", "") == sessionId
        && lease.get("sessionCreatedAt", 0) is number
        && lease.get("sessionCreatedAt", 0) > data.get("sessionValidAfter", 0)
        && lease.get("validUntilMs", 0) is number
        && request.time.toMillis() < lease.get("validUntilMs", 0);
    }

    function mobilePasswordAccessAllowed(data) {
      let token = request.auth.token;
      let firebaseClaims = token.get("firebase", {});
      let appCutoff = data.get("appPasswordSessionAfter", 0);
      let reset = data.get("firebasePasswordResetAfter", null);
      let legacyGrant = data.get("legacyClerkWebAccess", {});
      return directSessionAllowed(data)
        && ((trustedClerkSession(data, !token.keys().hasAny(["clerkLeaseVersion"])
              && legacyGrant is map && legacyGrant.get("allowEmptyEmployeeClaim", false) == true)
            && ((token.get("clerkLeaseVersion", 0) == 1
                && data.get("clerkLeaseRequired", false) == true && clerkLeaseAllowed(data))
              || legacyClerkWebAllowed(data, legacyGrant))
            && data.get("clerkPasswordResetAfter", null) == null)
          || (firebaseClaims is map
            && firebaseClaims.get("sign_in_provider", "") == "password"
            && data.get("authMigrationState", "") != "clerk-only"
            && data.get("appPasswordSetupRequired", false) == false
            && (reset == null || reset == 0)
            && data.get("mobileAccessStatus", "") == "active"
            && data.get("employeeId", "") is string
            && data.get("employeeId", "").size() > 0
            && data.get("companyId", "") is string
            && data.get("companyId", "").size() > 0
            && appCutoff is number && appCutoff >= 0 && appCutoff < 10000000000
            && token.get("auth_time", 0) > appCutoff));
    }

    function isActiveUserData(data) {
      return data != null
        && data.get("isEnabled", false) == true
        && data.get("active", true) != false
        && data.get("disabled", false) != true
        && data.get("appDisabled", false) != true
        && data.get("archived", false) != true
        && data.get("isArchived", false) != true
        && mobilePasswordAccessAllowed(data);
    }

    function isPlatformAdminData(data) {
      return data.get("role", "") in [
        "platformAdmin",
        "platformadmin",
        "platform admin",
        "Platform Admin",
        "superAdmin",
        "superadmin",
        "super admin",
        "Super Admin"
      ];
    }

    function isAdminData(data) {
      return isPlatformAdminData(data)
        || data.get("role", "") in [
          "admin",
          "Admin",
          "companyAdmin",
          "companyadmin",
          "company admin",
          "Company Admin"
        ];
    }

    function hasWorkspaceAccessData(data, workspace) {
      let access = data.get("appAccess", {});
      return isAdminData(data)
        || (
          access is map
          && access.get(workspace, false) == true
        );
    }

    function isNotDisabled() {
      return isSignedIn() && isActiveUserData(userData());
    }

    function isPlatformAdmin() {
      let data = userData();
      return isSignedIn()
        && isActiveUserData(data)
        && isPlatformAdminData(data);
    }

    function isAdmin() {
      let data = userData();
      return isSignedIn()
        && isActiveUserData(data)
        && isAdminData(data);
    }

    function isFinanceReviewerData(data) {
      return isAdminData(data)
        || data.get("role", "") in [
          "finance",
          "Finance",
          "financeManager",
          "finance manager",
          "Finance Manager"
        ]
        || data.get("financeAccess", false) == true;
    }

    function isFinanceReviewer() {
      let data = userData();
      return isSignedIn()
        && isActiveUserData(data)
        && isFinanceReviewerData(data);
    }

    function canUseSoftware() {
      return isNotDisabled();
    }

    function canAccessCompany(companyId) {
      let data = userData();
      return isSignedIn()
        && isActiveUserData(data)
        && (
          isPlatformAdminData(data)
          || (
            data.get("companyId", "") is string
            && data.get("companyId", "").size() > 0
            && data.get("companyId", "") == companyId
          )
        );
    }

    function hasUserAccess() {
      let data = userData();
      return isSignedIn()
        && isActiveUserData(data)
        && hasWorkspaceAccessData(data, "user");
    }

    // Evaluate the session once per permission statement; composing the full
    // company and workspace predicates exceeded Storage's expression budget.
    function canUseCompanyWorkspace(companyId, workspace) {
      let data = userData();
      return isSignedIn() && isActiveUserData(data)
        && (isPlatformAdminData(data) || (data.get("companyId", "") is string
          && data.get("companyId", "").size() > 0 && data.get("companyId", "") == companyId))
        && hasWorkspaceAccessData(data, workspace);
    }

    function canAdministerCompany(companyId) {
      let data = userData();
      return isSignedIn() && isActiveUserData(data) && isAdminData(data)
        && (isPlatformAdminData(data) || (data.get("companyId", "") is string
          && data.get("companyId", "").size() > 0 && data.get("companyId", "") == companyId));
    }

    function hasServiceAccess() {
      let data = userData();
      return isSignedIn()
        && isActiveUserData(data)
        && hasWorkspaceAccessData(data, "service");
    }

    function isSafeFileSize(maxBytes) {
      return request.resource.size != null && request.resource.size <= maxBytes;
    }

    function isSafeMimeType(allowed) {
      return request.resource.contentType != null
        && request.resource.contentType.matches(allowed);
    }

    match /profilePhotos/{uid}/{allPaths=**} {
      allow read: if canUseSoftware();
      allow write: if canUseSoftware()
        && (request.auth.uid == uid || isAdminData(userData()))
        && isSafeFileSize(10 * 1024 * 1024)
        && isSafeMimeType('image/.*');
    }

    match /companies/{companyId}/profilePhotos/{uid}/{allPaths=**} {
      allow read: if canAccessCompany(companyId);
      allow write: if canAccessCompany(companyId)
        && (request.auth.uid == uid || isAdminData(userData()))
        && isSafeFileSize(10 * 1024 * 1024)
        && isSafeMimeType('image/.*');
    }

    match /companies/{companyId}/booking_pdfs/{allPaths=**} {
      allow read: if canUseCompanyWorkspace(companyId, "user");
      allow write: if canUseCompanyWorkspace(companyId, "user")
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf');
    }

    // Final issued invoices are written and read only by trusted server routes.
    // Browser access is deliberately denied so immutable objects cannot be replaced.
    match /companies/{companyId}/issued-invoices/{invoiceId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /companies/{companyId}/quotes/{allPaths=**} {
      allow read: if canUseCompanyWorkspace(companyId, "user");
      allow write: if canUseCompanyWorkspace(companyId, "user")
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet|application/vnd\\.ms-excel|text/csv|image/.*|application/octet-stream');
    }

    match /companies/{companyId}/job_attachments/{jobId}/{allPaths=**} {
      allow read: if canUseCompanyWorkspace(companyId, "user");
      allow write: if canUseCompanyWorkspace(companyId, "user")
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    // Submitted legacy evidence is retained. The API owns new final evidence.
    match /companies/{companyId}/receipts/{uid}/{receiptId}/{fileName} {
      allow read: if isNotDisabled()
        && userData().get("companyId", "") == companyId
        && (request.auth.uid == uid || isAdminData(userData()) || userData().get("financeAccess", false) == true);
      allow write: if false;
    }

    match /companies/{companyId}/receipt-staging/{uid}/{evidenceId}/source {
      function validReceiptUpload() {
        let intent = firestore.get(/databases/(default)/documents/receiptUploadIntents/$(evidenceId)).data;
        return intent.uid == uid && intent.companyId == companyId
          && intent.status == "pending"
          && intent.expiresAtMillis > request.time.toMillis()
          && intent.fileSize == request.resource.size
          && intent.fileType == request.resource.contentType;
      }
      allow create: if resource == null && isNotDisabled() && request.auth.uid == uid
        && userData().get("companyId", "") == companyId
        && isSafeFileSize(15 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/jpeg|image/png|image/webp|image/gif')
        && validReceiptUpload();
      allow read, update, delete: if false;
    }
    match /companies/{companyId}/receipt-evidence/{allPaths=**} { allow read, write: if false; }
    match /companies/{companyId}/receipt-imports/{allPaths=**} { allow read, write: if false; }
    match /companies/{companyId}/receipt-exports/{allPaths=**} { allow read, write: if false; }

    match /companies/{companyId}/maintenance-quotes/{allPaths=**} {
      allow read: if canUseCompanyWorkspace(companyId, "service");
      allow write: if canUseCompanyWorkspace(companyId, "service")
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    match /companies/{companyId}/vehicles/{vehicleId}/{field}/{allPaths=**} {
      allow read: if canUseCompanyWorkspace(companyId, "service");
      allow write: if canUseCompanyWorkspace(companyId, "service")
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    match /companies/{companyId}/workshopVehicleChecks/{requestId}/{allPaths=**} {
      allow read: if canUseCompanyWorkspace(companyId, "service");
      allow write: if canUseCompanyWorkspace(companyId, "service")
        && isSafeFileSize(20 * 1024 * 1024)
        && isSafeMimeType('image/.*');
    }

    match /companies/{companyId}/equipment/{equipmentId}/inspections/{fileName} {
      allow read, delete: if canUseCompanyWorkspace(companyId, "service");
      allow create: if canUseCompanyWorkspace(companyId, "service")
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/jpeg|image/png|image/webp');
      allow update: if false;
    }

    match /companies/{companyId}/hr/contracts/{employeeRef}/{allPaths=**} {
      allow read: if canAdministerCompany(companyId);
      allow write: if canAdministerCompany(companyId)
        && isSafeFileSize(25 * 1024 * 1024);
    }

    match /recce-photos/{uid}/{bookingId}/{allPaths=**} {
      allow read: if hasUserAccess();
      allow write: if hasUserAccess()
        && request.auth.uid == uid
        && isSafeFileSize(20 * 1024 * 1024)
        && isSafeMimeType('image/.*');
    }

    // Mobile evidence writers use UID-owned paths. Preserve account and workspace gates.
    match /expenses/{uid}/{allPaths=**} {
      allow read: if hasUserAccess() && request.auth.uid == uid;
      allow create, update: if hasUserAccess() && request.auth.uid == uid
        && isSafeFileSize(10 * 1024 * 1024) && isSafeMimeType('image/.*');
    }
    match /vehicle-checks/{uid}/{checkId}/{allPaths=**} {
      allow read: if hasUserAccess() && request.auth.uid == uid;
      allow create: if resource == null && hasUserAccess() && request.auth.uid == uid
        && isSafeFileSize(20 * 1024 * 1024) && isSafeMimeType('image/.*');
    }
    match /uploads/photos/{uid}/{yyyy}/{mm}/{filename} {
      allow read: if hasUserAccess() && request.auth.uid == uid;
      allow create: if hasUserAccess() && request.auth.uid == uid
        && isSafeFileSize(20 * 1024 * 1024) && isSafeMimeType('image/.*');
    }
    match /vehicleIssues/{uid}/{issueId}/{allPaths=**} {
      allow read: if hasUserAccess() && request.auth.uid == uid;
      allow create: if hasUserAccess() && request.auth.uid == uid
        && isSafeFileSize(10 * 1024 * 1024) && isSafeMimeType('image/.*');
    }
    match /recces/{bookingId}/{dateISO}/{uid}/{allPaths=**} {
      function ownedRecceBooking() {
        let booking = firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
        return hasUserAccess() && request.auth.uid == uid
          && booking.get("companyId", "") == userData().get("companyId", "");
      }
      allow read: if ownedRecceBooking();
      allow create: if ownedRecceBooking()
        && isSafeFileSize(20 * 1024 * 1024) && isSafeMimeType('image/.*');
    }

    /* Shared technical-library documents used by the employee mobile app. */
    match /insurance/{allPaths=**} {
      allow read: if hasUserAccess();
    }

    match /{folder}/{allPaths=**} {
      allow read: if hasUserAccess() && folder == "spec sheets";
    }

    match /booking_pdfs/{allPaths=**} {
      allow read: if hasUserAccess();
      allow write: if hasUserAccess()
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf');
    }

    match /quotes/{allPaths=**} {
      allow read: if hasUserAccess();
      allow write: if hasUserAccess()
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet|application/vnd\\.ms-excel|text/csv|image/.*|application/octet-stream');
    }

    match /job_attachments/{jobId}/{allPaths=**} {
      allow read: if hasUserAccess();
      allow write: if hasUserAccess()
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    match /maintenance-quotes/{allPaths=**} {
      allow read: if hasServiceAccess();
      allow write: if hasServiceAccess()
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    match /vehicles/{vehicleId}/{field}/{allPaths=**} {
      allow read: if hasServiceAccess();
      allow write: if hasServiceAccess()
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    match /hr/contracts/{employeeRef}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isSafeFileSize(25 * 1024 * 1024);
    }

    match /h-and-s/training-policy/{employeeRef}/{itemId}/{allPaths=**} {
      allow read: if hasUserAccess();
      allow write: if hasUserAccess()
        && isSafeFileSize(25 * 1024 * 1024);
    }

    match /h-and-s/certificates/{checkId}/{allPaths=**} {
      allow read: if hasUserAccess();
      allow write: if hasUserAccess()
        && isSafeFileSize(25 * 1024 * 1024)
        && isSafeMimeType('application/pdf|image/.*|application/octet-stream');
    }

    match /images/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isSafeFileSize(10 * 1024 * 1024)
        && isSafeMimeType('image/.*');
    }

    match /debug/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
